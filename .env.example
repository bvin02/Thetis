# Copy this file to .env and fill in your key. Never commit .env.
# Only the Python backend reads these values.

# Your Anthropic API key (from the Claude Console). Leave empty to run without Claude features.
ANTHROPIC_API_KEY=

# Model for the second opinion and explanations. claude-haiku-5-5 is cheaper.
CLAUDE_MODEL=claude-sonnet-5-5

# Hard cap on Claude API calls per day, to protect your credits.
CLAUDE_DAILY_LIMIT=100
